{
  "$defs": {
    "BundleContent": {
      "additionalProperties": false,
      "description": "content.json 协议。\n\n成片形态自契约 1.1.0 起属于 render.json，旧版工具产出的包里可能仍带着\n``video_format`` 或更早的 ``aspect_ratio``，这里静默剥离以免整包校验失败，\n解析服务会另行给出告警。",
      "properties": {
        "schema_version": {
          "maximum": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "script": {
          "maxLength": 6000,
          "minLength": 1,
          "title": "Script",
          "type": "string"
        },
        "hook_headline": {
          "anyOf": [
            {
              "$ref": "#/$defs/BundleHookHeadline"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pronunciations": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Pronunciations",
          "type": "object"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "notes": {
          "default": "",
          "maxLength": 2000,
          "title": "Notes",
          "type": "string"
        },
        "prepared_for": {
          "anyOf": [
            {
              "enum": [
                "landscape-full-v1",
                "landscape-footage-v1"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prepared For"
        },
        "editorial": {
          "anyOf": [
            {
              "$ref": "#/$defs/EditorialPreparation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "schema_version",
        "title",
        "script"
      ],
      "title": "BundleContent",
      "type": "object"
    },
    "BundleHookHeadline": {
      "additionalProperties": false,
      "description": "content.json 中的钩子标题与可选英文副标题。",
      "properties": {
        "lines": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Lines",
          "type": "array"
        },
        "subtitle": {
          "default": "",
          "maxLength": 72,
          "title": "Subtitle",
          "type": "string"
        }
      },
      "title": "BundleHookHeadline",
      "type": "object"
    },
    "BundleManifest": {
      "additionalProperties": false,
      "description": "manifest.json 协议。",
      "properties": {
        "schema_version": {
          "maximum": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "generated_by": {
          "default": "",
          "maxLength": 200,
          "title": "Generated By",
          "type": "string"
        },
        "notes": {
          "default": "",
          "maxLength": 2000,
          "title": "Notes",
          "type": "string"
        },
        "assets": {
          "items": {
            "$ref": "#/$defs/BundleManifestAsset"
          },
          "maxItems": 200,
          "title": "Assets",
          "type": "array"
        }
      },
      "required": [
        "schema_version"
      ],
      "title": "BundleManifest",
      "type": "object"
    },
    "BundleManifestAsset": {
      "additionalProperties": false,
      "description": "manifest.json 中的单个素材条目。",
      "properties": {
        "file": {
          "maxLength": 260,
          "minLength": 1,
          "title": "File",
          "type": "string"
        },
        "kind": {
          "enum": [
            "image",
            "video"
          ],
          "title": "Kind",
          "type": "string"
        },
        "summary": {
          "default": "",
          "maxLength": 240,
          "title": "Summary",
          "type": "string"
        },
        "tags": {
          "items": {
            "maxLength": 32,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Tags",
          "type": "array"
        },
        "source_url": {
          "default": "",
          "maxLength": 2000,
          "title": "Source Url",
          "type": "string"
        },
        "license": {
          "default": "",
          "maxLength": 128,
          "title": "License",
          "type": "string"
        },
        "script_anchor": {
          "default": "",
          "maxLength": 512,
          "title": "Script Anchor",
          "type": "string"
        },
        "clip_start_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clip Start Seconds"
        },
        "clip_end_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clip End Seconds"
        },
        "relevance_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relevance Score"
        },
        "editorial": {
          "anyOf": [
            {
              "$ref": "#/$defs/EditorialAsset"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "file",
        "kind"
      ],
      "title": "BundleManifestAsset",
      "type": "object"
    },
    "EditorialAsset": {
      "additionalProperties": false,
      "description": "素材的叙事角色、来源关系与构图提示，不执行抽帧或抠图。",
      "properties": {
        "role": {
          "enum": [
            "footage",
            "foreground",
            "reference_image"
          ],
          "title": "Role",
          "type": "string"
        },
        "subject": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject"
        },
        "segment_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Segment Ids",
          "type": "array"
        },
        "title_candidate": {
          "default": false,
          "title": "Title Candidate",
          "type": "boolean"
        },
        "derived_from": {
          "anyOf": [
            {
              "$ref": "#/$defs/EditorialDerivedFrom"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "focus": {
          "anyOf": [
            {
              "$ref": "#/$defs/EditorialFocus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "role"
      ],
      "title": "EditorialAsset",
      "type": "object"
    },
    "EditorialDerivedFrom": {
      "additionalProperties": false,
      "description": "前景来源视频与抽帧时间，时间相对包内该视频的起点。",
      "properties": {
        "file": {
          "maxLength": 260,
          "minLength": 1,
          "title": "File",
          "type": "string"
        },
        "at_seconds": {
          "minimum": 0,
          "title": "At Seconds",
          "type": "number"
        }
      },
      "required": [
        "file",
        "at_seconds"
      ],
      "title": "EditorialDerivedFrom",
      "type": "object"
    },
    "EditorialFocus": {
      "additionalProperties": false,
      "description": "相对源画面的归一化目标框，x、y 表示左上角。",
      "properties": {
        "x": {
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Height",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "EditorialFocus",
      "type": "object"
    },
    "EditorialPreparation": {
      "additionalProperties": false,
      "description": "面向指定版面的备料说明，不覆盖实际选中的版面。",
      "properties": {
        "prepared_for": {
          "const": "landscape-editorial-motion-v1",
          "title": "Prepared For",
          "type": "string"
        },
        "title_text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Title Text",
          "type": "string"
        },
        "title_anchor": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Title Anchor",
          "type": "string"
        },
        "segments": {
          "items": {
            "$ref": "#/$defs/EditorialSegment"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Segments",
          "type": "array"
        }
      },
      "required": [
        "prepared_for",
        "title_text",
        "title_anchor",
        "segments"
      ],
      "title": "EditorialPreparation",
      "type": "object"
    },
    "EditorialSegment": {
      "additionalProperties": false,
      "description": "原文片段的叙事用途；锚点不替代或改写定稿文案。",
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "script_anchor": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Script Anchor",
          "type": "string"
        },
        "role": {
          "enum": [
            "hook",
            "title",
            "origin",
            "explain",
            "evidence",
            "contrast",
            "conclusion"
          ],
          "title": "Role",
          "type": "string"
        },
        "visual_goal": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Visual Goal",
          "type": "string"
        }
      },
      "required": [
        "id",
        "script_anchor",
        "role",
        "visual_goal"
      ],
      "title": "EditorialSegment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "素材就绪时提交的两份 JSON 与封面路径。\n\n这里不收渲染配置：配置属于某一次渲染，只在用户点开始渲染时随版本一起落库。\n标题同理不单独提交，由服务端取 ``content.title``，避免两处标题对不上时无从\n判断该听谁的。",
  "properties": {
    "content": {
      "$ref": "#/$defs/BundleContent"
    },
    "manifest": {
      "$ref": "#/$defs/BundleManifest"
    },
    "cover_path": {
      "anyOf": [
        {
          "maxLength": 512,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cover Path"
    }
  },
  "required": [
    "content",
    "manifest"
  ],
  "title": "BundleSubmitRequest",
  "type": "object",
  "x-niwo": {
    "contract_version": "1.2.0",
    "media_files_max": 100,
    "zip_bytes_max": 209715200,
    "image_bytes_max": 26214400,
    "video_bytes_max": 536870912
  }
}
